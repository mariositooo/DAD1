package Cliente;
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.io.OutputStreamWriter;
import java.io.PrintWriter;
import java.net.Socket;
import java.nio.charset.StandardCharsets;
import java.util.Scanner;


public class Cliente {
	
	public static void main(String[] args) {
		String host = "127.0.0.1";
		int puerto = 5000;
		
		 try (
				 Socket socket = new Socket(host, puerto);   // aquí se conecta
		            BufferedReader entrada = new BufferedReader(
		                    new InputStreamReader(socket.getInputStream(), StandardCharsets.UTF_8));
		            PrintWriter salida = new PrintWriter(
		                    new OutputStreamWriter(socket.getOutputStream(), StandardCharsets.UTF_8), true);
		            Scanner teclado = new Scanner(System.in)    // para leer lo que escribes en consola
		        ) {
		            System.out.println("Conectado. Escribe mensajes (FIN para salir):");
		            while (true) {
		                System.out.print("> ");
		                String mensaje = teclado.nextLine();
		                if (mensaje.equals("FIN")) break;   // en Java los String se comparan con equals, no con == 

		                salida.println(mensaje);                 // enviar
		                String respuesta = entrada.readLine();   // esperar la respuesta
		                if (respuesta == null) {
		                    System.out.println("El servidor ha cerrado la conexión");
		                    break;
		                }
		                System.out.println("Servidor: " + respuesta);
		            }
		        } catch (IOException e) {
		            System.err.println("No se pudo conectar con el servidor: " + e.getMessage());
		        }
		    }
	

		}
