package Servidor;
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.io.OutputStreamWriter;
import java.io.PrintWriter;
import java.net.Socket;
import java.nio.charset.StandardCharsets;

public class HiloCliente extends Thread{
	//Conexion con ESTE cliente
	private final Socket socket;
	
	public HiloCliente(Socket socket) {
		this.socket=socket;
	}
	@Override
	
	public void run() {
		
		try(
			//Para leer lineas de texto del cliente (en formato UTF-8, como pide el protocolo)
			BufferedReader entrada = new BufferedReader(new InputStreamReader(socket.getInputStream(), StandardCharsets.UTF_8));
			//Para mandar lineas al cliente, el true es un autoflush: envía al momento el mensaje
			PrintWriter salida = new PrintWriter(new OutputStreamWriter(socket.getOutputStream(), StandardCharsets.UTF_8));
				){
			
			String linea;
			//readLine() devuelve null cuando no hay clientes o cuando el cliente cierra la conexion
			while((linea = entrada.readLine()) != null) {
				System.out.println("Recibido: " + linea);
				salida.println("ECO" + linea); //de momento solo devuelve lo mismo
			}
		}catch(IOException e){
				System.err.println("conexion perdida: " + e.getMessage());
		}
		//Al cerrar entrada/salida se cierra también el socket
		System.out.println("Cliente desconectado");
		
	}
}
